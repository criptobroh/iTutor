# Cerebro: clave de la API de Anthropic.
# Conseguila en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude por default. Opciones (de más barato a más caro):
#   claude-haiku-4-5-20251001    ← default, suficiente para tutoría general
#   claude-sonnet-4-6            ← reservado para tareas complejas
#   claude-opus-4-7              ← reservado para razonamiento pesado
ITUTOR_MODEL=claude-haiku-4-5-20251001

# Modelo "fallback" cuando Claude detecta una tarea más compleja (multi-step
# UI navigation, código complejo, planificación). El runner lo elige
# automáticamente si el system prompt lo pide.
ITUTOR_MODEL_HEAVY=claude-sonnet-4-6

# Máximo ancho en píxeles al que reescalamos screenshots antes de mandarlos
# a Claude. Los tokens vision son proporcionales a área (≈ w*h/750), así que
# bajar de 2560 a 1280 reduce ~75% el costo por imagen.
ITUTOR_SCREENSHOT_MAX_WIDTH=1280

# LiveAvatar (sucesor oficial de HeyGen Interactive Avatar) — para que el profe
# tenga cara y voz reales con lip-sync en tiempo real.
# Sign up + API key: https://app.liveavatar.com → Settings → API Keys
LIVEAVATAR_API_KEY=

# Avatar ID. Listado de públicos: https://docs.liveavatar.com → Avatar Library
LIVEAVATAR_AVATAR_ID=Wayne_20240711

# Idioma de la voz (ISO 639-1: es, en, pt, fr, …)
LIVEAVATAR_LANGUAGE=es

# Voice ID opcional. Si lo dejás vacío, LiveAvatar elige el default del avatar.
LIVEAVATAR_VOICE_ID=

# Hotkey global. Default Cmd+Space (mac) / Ctrl+Space (win).
ITUTOR_HOTKEY=CommandOrControl+Space

# Path al binario whisper.cpp (auto-resuelto si está en PATH o instalado vía nodejs-whisper)
WHISPER_MODEL=base
